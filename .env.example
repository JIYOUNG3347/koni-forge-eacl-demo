# ── Server ──────────────────────────────────────────────────────────────────
APP_HOST=127.0.0.1
APP_PORT=8000
INTERNAL_API_URL=http://localhost:8000      # internal API base URL (worker -> app)
CORS_ORIGINS=http://localhost:5173          # allowed origins, comma separated

# ── LLM / model access ───────────────────────────────────────────────────────
OPENAI_API_KEY=                             # required: the agents and the KBD judge use it
HF_TOKEN=                                   # needed for gated/private repos (public ones work without it)
MODEL_DOWNLOAD_TIMEOUT_SECONDS=3600         # per-download job timeout
RAG_EMBEDDING_MODEL=multilingual-e5-base    # embedding model used for RAG indexing

# ── Redis / Celery ───────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0          # sessions and job state
SESSION_TTL_SECONDS=86400                   # session lifetime (24h)
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── Training ─────────────────────────────────────────────────────────────────
TRAIN_TIMEOUT_SECONDS=7200                  # training job timeout
INDEX_TIMEOUT_SECONDS=1800                  # document indexing job timeout
INDEX_REQUEST_TIMEOUT_SECONDS=900           # per-request timeout (the first one downloads the embedding model)
KBD_PROBE_TIMEOUT_SECONDS=3600              # KBD probe job timeout
SUBPROCESS_TIMEOUT_SECONDS=30               # timeout for nvidia-smi and similar calls
TRAIN_SEED=42                               # reproducibility
TRAIN_BATCH_GUARD=1                         # 1 = clamp the batch to the estimated memory
# KONI_DEVICE=                              # force cuda | mps | cpu (detected when unset)
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True   # return VRAM to the CUDA driver

# ── Security ─────────────────────────────────────────────────────────────────
# INTERNAL_TOKEN authenticates worker -> app calls. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Internal calls fail closed when it is empty.
INTERNAL_TOKEN=
BCRYPT_COST_FACTOR=12
LOGIN_MAX_FAILURES_IP=5
LOGIN_MAX_FAILURES_ACCOUNT=10
LOGIN_LOCKOUT_SECONDS=300

# ── Admin account ────────────────────────────────────────────────────────────
KONI_ADMIN_ID=admin
KONI_ADMIN_PW=                              # set before the first start

# ── Operations ───────────────────────────────────────────────────────────────
JOB_HISTORY_MAX_COUNT=1000
JOB_HISTORY_RETENTION_DAYS=30
LOG_ROTATION_INTERVAL=D                     # D = daily, H = hourly
LOG_BACKUP_COUNT=30

# ── Storage ──────────────────────────────────────────────────────────────────
# The storage root comes from host.toml [paths]; these override sub-paths only.
# CHROMA_PERSIST_DIR=./storage/chroma
# LOGS_DIR=./storage/logs

# ── Agent orchestration ──────────────────────────────────────────────────────
# graph (default) = a supervisor LLM picks the next specialist; legacy = keyword routing
ORCHESTRATOR_MODE=graph
# legacy = record leases only; managed = enforce admission control across jobs
GPU_ALLOC_MODE=legacy
GPU_ADMISSION_MAX_RETRIES=240
