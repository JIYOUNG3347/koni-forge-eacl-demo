# host.toml — optional operator limits.
#
# Copy to ./host.toml (project root) or /etc/koniforge/host.toml and edit.
# Every key is optional; the values below are the defaults.

[model_limits]
max_train_param_b = 14      # largest model accepted for training, in billions of parameters
max_train_seq_length = 2048 # training sequence-length ceiling
max_train_batch_size = 8    # per-device batch ceiling (OOM guard)

[concurrency]
max_concurrent_train_jobs = 1  # training jobs allowed to run at once
max_concurrent_kbd_jobs = 1    # KBD probe jobs allowed to run at once

[paths]
storage_base = "./storage"     # models, corpora, datasets, checkpoints, logs
