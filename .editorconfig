# EditorConfig: https://editorconfig.org
# Top-most EditorConfig file
root = true

# Default for all files
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Python: 4 spaces, 120-char line (matches the ruff config in pyproject.toml)
[*.py]
indent_size = 4
max_line_length = 120

# Markdown: preserve trailing whitespace for line breaks
[*.md]
trim_trailing_whitespace = false

# Makefile: tabs are required
[Makefile]
indent_style = tab

# YAML files
[*.{yml,yaml}]
indent_size = 2

# TOML files
[*.toml]
indent_size = 4
